# Optional — only needed if you hit rate limits on GoPlus's free tier
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# Wallet-data providers for POST /analyze/wallet. EVM wallets use Moralis first
# and fall back to Alchemy; Solana wallets use Helius. Leave a key blank to
# disable that provider — the wallet endpoint then returns a structured
# "provider unavailable" error rather than fabricated/mock data.
MORALIS_API_KEY=
ALCHEMY_API_KEY=
HELIUS_API_KEY=

# Optional overrides for the provider endpoints (defaults shown). Only set these
# to point at a different Alchemy/Moralis/Helius base URL or a proxy.
# ALCHEMY_ETH_BASE_URL=https://eth-mainnet.g.alchemy.com/v2
# MORALIS_BASE_URL=https://deep-index.moralis.io/api/v2.2
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/
# HELIUS_TRANSACTION_URL=https://api-mainnet.helius-rpc.com/v0

# Required for AI explanations (falls back to a templated explanation if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Comma-separated list of origins allowed to call the API (CORS). Defaults to the
# production frontend domains plus the local Vite dev server if unset.
ALLOWED_ORIGINS=https://cryptoduediligence.dev,https://www.cryptoduediligence.dev,http://localhost:5173

# Shared secret gating the GET /analyze/token/raw debug endpoint. Send it as the
# X-Debug-Key header. If unset, the endpoint returns 404 for everyone.
DEBUG_API_KEY=
