# Optional — only needed if you hit rate limits on GoPlus's free tier
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# Required for AI explanations (falls back to a templated explanation if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Comma-separated list of origins allowed to call the API (CORS). Defaults to the
# production frontend domains plus the local Vite dev server if unset.
ALLOWED_ORIGINS=https://cryptoduediligence.dev,https://www.cryptoduediligence.dev,http://localhost:5173

# Shared secret gating the GET /analyze/token/raw debug endpoint. Send it as the
# X-Debug-Key header. If unset, the endpoint returns 404 for everyone.
DEBUG_API_KEY=
